APP_NAME=JPStore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=single
LOG_LEVEL=debug

# SQLite - funciona en Windows sin instalar nada extra
DB_CONNECTION=sqlite
# DB_DATABASE se deja vacío para usar la ruta por defecto: database/database.sqlite

# Para usar MySQL descomenta esto:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jpstore
# DB_USERNAME=root
# DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,127.0.0.1:5173

BROADCAST_CONNECTION=null

SUPER_ADMIN_NAME="Super Admin JPStore"
SUPER_ADMIN_EMAIL=admin@jpstore.com
SUPER_ADMIN_PASSWORD=JPStore2024!
